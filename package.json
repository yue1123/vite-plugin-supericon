{
  "name": "vite-plugin-supericon",
  "version": "0.0.6",
  "type": "module",
  "description": "vite plugin of auto generate iconfont from svg",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.js",
  "author": "dh<2572468699@qq.com>",
  "repository": {
    "type": "git",
    "url": "git@github.com:yue1123/vite-plugin-supericon.git"
  },
  "homepage": "https://github.com/yue1123/vite-plugin-supericon",
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "dev": "pnpm dev:node & pnpm dev:client",
    "build": "pnpm build:node & pnpm build:client",
    "dev:client": "vite serve src/client",
    "build:client": "vite build src/client",
    "preview:client": "vite preview src/client",
    "dev:node": "pnpm clean && tsup src/node/index.ts  --watch --dts --format esm",
    "build:node": "pnpm clean && tsup src/node/index.ts --dts --env.NODE_ENV production --format esm && pnpm clean-up",
    "clean": "rimraf dist",
    "clean-up": "rimraf tsconfig.tsbuildinfo",
    "demo:dev": "pnpm run -C demo dev",
    "demo:build": "pnpm run -C demo build",
    "demo:preview": "pnpm run -C demo preview"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "plugin",
    "icon",
    "iconfont",
    "svg convert",
    "svg icon",
    "super icon"
  ],
  "devDependencies": {
    "@iconify/vue": "catalog:frontend",
    "@rollup/plugin-typescript": "catalog:dev",
    "@tailwindcss/vite": "catalog:frontend",
    "@types/fs-extra": "catalog:dev",
    "@types/node": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:frontend",
    "@vueuse/core": "catalog:frontend",
    "naive-ui": "catalog:frontend",
    "prettier": "catalog:dev",
    "rimraf": "catalog:dev",
    "sass": "catalog:frontend",
    "tailwindcss": "catalog:frontend",
    "tsup": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev",
    "vite-hot-client": "catalog:frontend",
    "vite-plugin-inspect": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-tsc": "catalog:frontend"
  },
  "dependencies": {
    "@twbs/fantasticon": "catalog:prod",
    "fs-extra": "catalog:prod",
    "highlight.js": "catalog:frontend",
    "makerjs": "^0.19.2",
    "open": "catalog:prod",
    "paper": "catalog:frontend",
    "picocolors": "catalog:prod",
    "prismjs": "catalog:frontend",
    "sirv": "catalog:prod"
  },
  "peerDependencies": {
    "vite": "*"
  }
}
