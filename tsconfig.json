{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "lib": ["esnext", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strictNullChecks": true,
    "noEmit": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.ts", "src/node/icon.js", "shim.d.ts"],
  "exclude": ["dist/**/*", "node_modules", "test/**/*", "demo/**/*"]
}
